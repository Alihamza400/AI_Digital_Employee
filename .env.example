# === AI Employee — Configuration Template ===
# Copy this to .env and fill in your values.
# Never commit .env to version control.

VAULT_PATH=AI_Employee_Vault

# Gmail API — OAuth 2.0 (individual values)
# Get CLIENT_ID and CLIENT_SECRET from Google Cloud Console > Credentials
# Get REFRESH_TOKEN by running: uv run python auth_gmail.py
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_PROJECT_ID=your-project-id
GMAIL_REFRESH_TOKEN=your-refresh-token

# Google Calendar API — separate OAuth client from Gmail
# Get CLIENT_ID and CLIENT_SECRET from Google Cloud Console > Credentials (different client)
# Get REFRESH_TOKEN by running: uv run python auth_calendar.py
CALENDAR_CLIENT_ID=your-calendar-client-id.apps.googleusercontent.com
CALENDAR_CLIENT_SECRET=your-calendar-client-secret
CALENDAR_PROJECT_ID=your-project-id
CALENDAR_REFRESH_TOKEN=your-calendar-refresh-token

# Email for approval notifications
NOTIFY_EMAIL=your.email@gmail.com

# Approval server (auto-detected if empty)
APPROVAL_URL=http://192.168.1.100:8080
APPROVAL_PORT=8080

# Playwright browser session directories (gitignored)
WHATSAPP_SESSION=AI_Employee_Vault/whatsapp_session
LINKEDIN_SESSION=AI_Employee_Vault/linkedin_session
